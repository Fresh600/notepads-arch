pkgname=notepads-arch
pkgver=0.3.0
pkgrel=1
pkgdesc='A clean, translucent, tabbed text editor for Arch and Omarchy'
provides=('notepads')
conflicts=('notepads')
replaces=('notepads')
arch=('x86_64' 'aarch64')
license=('MIT')
depends=('qt6-base' 'qt6-declarative' 'qt6-svg' 'qt6-wayland' 'xdg-desktop-portal')
makedepends=('gcc' 'make')
source=()
sha256sums=()

build() {
  cd "$startdir/.."
  ./bin/build
}

package() {
  cd "$startdir/.."
  install -Dm755 build/notepads "$pkgdir/usr/bin/notepads"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 src/fonts/OFL.txt "$pkgdir/usr/share/licenses/$pkgname/OFL-NotepadsHebrew.txt"
  install -Dm644 "$startdir/notepads.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/notepads.svg"
  install -Dm644 "$startdir/notepads.desktop" "$pkgdir/usr/share/applications/notepads.desktop"
}
